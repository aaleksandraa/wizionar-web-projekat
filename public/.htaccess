RewriteEngine On

# Keep /api for the Node proxy in Apache vhost. Do not send it to index.html.
RewriteRule ^api(/.*)?$ - [L]

# Serve existing prerendered pages, assets and files.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for client-side routes.
RewriteRule ^ index.html [L]
